datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  employeeId   String?       @unique // Pjsofonic ERP Employee ID (e.g. PJ-EMP-101, PJ-ADM-001)
  name         String
  email        String        @unique
  password     String
  role         String        @default("EMPLOYEE") // ADMIN, EMPLOYEE, PROJECT_MANAGER, DEVELOPER, VIEWER
  department   String?       @default("Pjsofonic Engineering")
  erpSystem    String        @default("Pjsofonic ERP")
  isErpVerified Boolean      @default(true)
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  ownedProjects     Project[]          @relation("ProjectOwner")
  memberships       ProjectMember[]
  reportedProblems  Problem[]          @relation("ProblemReporter")
  assignedProblems  Problem[]          @relation("ProblemOwner")
  assignedTasks     Task[]             @relation("TaskAssignee")
  reqsOwned         Requirement[]      @relation("ReqOwner")
  risksOwned        Risk[]             @relation("RiskOwner")
  articles          KnowledgeArticle[]
  activities        Activity[]
  notifications     Notification[]
  uploadedFiles     File[]
  uploadedArtifacts ProjectArtifact[]
}

model Workspace {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects  Project[]
}

model Project {
  id              String          @id @default(uuid())
  name            String
  description     String
  type            String          @default("Software Development")
  priority        String          @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  status          String          @default("ACTIVE") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, ARCHIVED
  startDate       String?
  targetDate      String?
  ownerId         String
  techStack       String          @default("[]") // JSON string of technologies
  goals           String          @default("[]") // JSON string of goals
  successCriteria String          @default("[]") // JSON string of criteria
  healthStatus    String          @default("GREEN") // GREEN, YELLOW, RED
  workspaceId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner           User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id])
  members         ProjectMember[]
  requirements    Requirement[]
  problems        Problem[]
  tasks           Task[]
  decisions       Decision[]
  knowledge       KnowledgeArticle[]
  risks           Risk[]
  files           File[]
  artifacts       ProjectArtifact[]
  activities      Activity[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("DEVELOPER") // OWNER, ADMIN, PROJECT_MANAGER, DEVELOPER, CONTRIBUTOR, VIEWER
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Requirement {
  id                 String   @id @default(uuid())
  reqId              String   // e.g. REQ-101
  title              String
  description        String
  type               String   @default("FUNCTIONAL") // FUNCTIONAL, NON_FUNCTIONAL, TECHNICAL, BUSINESS, SECURITY, PERFORMANCE
  priority           String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status             String   @default("PLANNED") // DRAFT, PLANNED, IN_PROGRESS, IMPLEMENTED, VERIFIED, REJECTED
  acceptanceCriteria String   @default("[]") // JSON array of items { id, text, completed }
  ownerId            String?
  dueDate            String?
  projectId          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner              User?    @relation("ReqOwner", fields: [ownerId], references: [id])
  problems           Problem[]
  tasks              Task[]
}

model Problem {
  id                   String   @id @default(uuid())
  probId               String   // e.g. PROB-201
  title                String
  description          String
  symptoms             String   // Detailed observations
  severity             String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  priority             String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  status               String   @default("IDENTIFIED") // IDENTIFIED, INVESTIGATING, ROOT_CAUSE_FOUND, SOLUTION_SELECTED, IN_PROGRESS, TESTING, RESOLVED, CLOSED
  impact               String   @default("High impact on service stability")
  frequency            String   @default("Intermittent under load")
  affectedModule       String   @default("Core Service")
  environmentScope     String   @default("Backend") // Terminal, Server, Backend, Frontend, Localhost
  resolutionSteps      String   @default("[]") // JSON array of steps taken to solve problem
  resolvedAt           DateTime?
  reporterId           String?
  ownerId              String?
  targetResolutionDate String?
  projectId            String
  requirementId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement          Requirement?      @relation(fields: [requirementId], references: [id])
  reporter             User?             @relation("ProblemReporter", fields: [reporterId], references: [id])
  owner                User?             @relation("ProblemOwner", fields: [ownerId], references: [id])
  rca                  RootCauseAnalysis?
  solutions            Solution[]
  tasks                Task[]
}

model RootCauseAnalysis {
  id                 String   @id @default(uuid())
  problemId          String   @unique
  method             String   @default("FIVE_WHYS") // FIVE_WHYS, FISHBONE
  fiveWhysData       String   @default("[]") // JSON array of { whyNumber, question, answer }
  causesData         String   @default("[]") // JSON array of { cause, category, status: POSSIBLE|UNDER_INVESTIGATION|CONFIRMED|REJECTED }
  confirmedRootCause String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  problem            Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Solution {
  id              String   @id @default(uuid())
  solId           String   // e.g. SOL-301
  problemId       String
  title           String
  description     String
  approach        String
  expectedOutcome String
  complexity      String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  cost            String   @default("LOW") // LOW, MEDIUM, HIGH
  risk            String   @default("LOW") // LOW, MEDIUM, HIGH
  impact          String   @default("HIGH") // LOW, MEDIUM, HIGH
  pros            String   @default("[]") // JSON string list
  cons            String   @default("[]") // JSON string list
  status          String   @default("PROPOSED") // PROPOSED, EVALUATING, SELECTED, REJECTED, IMPLEMENTED, VERIFIED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tasks           Task[]
}

model Task {
  id             String   @id @default(uuid())
  taskId         String   // e.g. TASK-401
  title          String
  description    String
  assigneeId     String?
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String   @default("TODO") // BACKLOG, TODO, IN_PROGRESS, REVIEW, TESTING, DONE
  startDate      String?
  dueDate        String?
  estimatedHours Float    @default(0)
  actualHours    Float    @default(0)
  checklist      String   @default("[]") // JSON array of { text, done }
  projectId      String
  requirementId  String?
  problemId      String?
  solutionId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement? @relation(fields: [requirementId], references: [id])
  problem        Problem?     @relation(fields: [problemId], references: [id])
  solution       Solution?    @relation(fields: [solutionId], references: [id])
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
}

model Decision {
  id             String   @id @default(uuid())
  decId          String   // e.g. DEC-501
  decision       String
  context        String
  reason         String
  alternatives   String   @default("[]") // JSON string list
  chosenApproach String
  impact         String
  decisionMaker  String
  date           String
  projectId      String
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model KnowledgeArticle {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("Technical Notes") // Requirements, Architecture, Technical Notes, Problems, Solutions, Decisions, Meeting Notes, Research, Documentation, Lessons Learned
  content   String
  tags      String   @default("[]") // JSON array of tags
  authorId  String?
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id])
}

model Risk {
  id          String   @id @default(uuid())
  riskId      String   // e.g. RISK-601
  title       String
  description String
  probability String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  impact      String   @default("HIGH") // LOW, MEDIUM, HIGH
  severity    String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  mitigation  String
  ownerId     String?
  status      String   @default("OPEN") // OPEN, MITIGATED, CLOSED
  dueDate     String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?    @relation("RiskOwner", fields: [ownerId], references: [id])
}

model File {
  id               String   @id @default(uuid())
  name             String
  size             Int
  mimeType         String
  path             String
  linkedEntityType String?  // REQUIREMENT, PROBLEM, SOLUTION, TASK, KNOWLEDGE
  linkedEntityId   String?
  projectId        String
  uploadedById     String?
  createdAt        DateTime @default(now())

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy       User?    @relation(fields: [uploadedById], references: [id])
}

model Activity {
  id         String   @id @default(uuid())
  projectId  String
  userId     String?
  userName   String
  action     String   // e.g. "created problem", "selected solution", "verified requirement"
  details    String
  entityType String   // PROJECT, REQUIREMENT, PROBLEM, SOLUTION, TASK, DECISION, FILE
  entityId   String?
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectArtifact {
  id           String   @id @default(uuid())
  title        String
  category     String   // IMPLEMENTATION_PLAN, WALKTHROUGH, PRESENTATION_PPT, PROJECT_LOGO, OTHER
  kind         String   @default("FILE") // FILE, LINK
  url          String   // Storage path or URL link
  fileSize     Int?     @default(0)
  mimeType     String?  @default("application/octet-stream")
  projectId    String
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
}
